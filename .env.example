# ===================================
# SUPABASE (Database & Auth)
# ===================================
# Public keys - safe to expose to browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ⚠️ SERVER ONLY - Admin access, bypasses RLS (Phase 2+)
# Get from: Supabase Dashboard > Settings > API > service_role key
# NEVER expose this key to browser code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===================================
# ANTHROPIC (Claude AI API)
# ===================================
# ⚠️ SERVER ONLY - AI discovery and SOW generation
# Get from: https://console.anthropic.com/account/keys
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY=sk-ant-your-api-key

# ===================================
# STRIPE (Billing & Subscriptions) - Phase 2+
# ===================================
# Get all Stripe keys from: https://dashboard.stripe.com/developers
# Use TEST keys (sk_test_*, pk_test_*) for development
# Use LIVE keys (sk_live_*, pk_live_*) for production

# ⚠️ SERVER ONLY - Secret key for backend billing operations
STRIPE_SECRET_KEY=sk_test_your-test-secret-key

# ⚠️ SERVER ONLY - Webhook signature verification
# Get from: Stripe Dashboard > Developers > Webhooks > Add endpoint
STRIPE_WEBHOOK_SECRET=whsec_test_your-webhook-secret

# Public key - Safe for frontend payment UI
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-test-publishable-key

# Stripe Price IDs - Create products in Stripe Dashboard > Products
# Copy the Price ID for each tier/interval combination
STRIPE_PRICE_PRO_MONTHLY=price_test_pro_monthly
STRIPE_PRICE_PRO_YEARLY=price_test_pro_yearly
STRIPE_PRICE_TEAM_MONTHLY=price_test_team_monthly
STRIPE_PRICE_TEAM_YEARLY=price_test_team_yearly

# ===================================
# INNGEST (Background Jobs) - Phase 3+
# ===================================
# Get from: https://app.inngest.com > Your App > Settings
# Used for SOW generation and other long-running tasks

INNGEST_EVENT_KEY=test_inngest_event_key
INNGEST_SIGNING_KEY=test_inngest_signing_key

# ===================================
# APPLICATION
# ===================================
# Base URL for redirects and webhook callbacks
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===================================
# POSTHOG (Analytics) - Optional
# ===================================
# Get from: https://app.posthog.com > Project Settings
# Leave empty to disable analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
